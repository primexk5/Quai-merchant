# Copy to `.env.local` and fill in.  cp .env.local.example .env.local

# Quai RPC used by the frontend (browser wallet + order status reads).
NEXT_PUBLIC_RPC_URL=https://orchard.rpc.quai.network
NEXT_PUBLIC_CHAIN_ID=15000

# Contract addresses (from contracts/deployments/<network>.json).
# Orchard testnet (cyprus1): PAYWITHQUAI below, MUSDQ is optional (the app falls back to it).
NEXT_PUBLIC_PAYWITHQUAI_ADDRESS=0x00707FB75afede47F3cE44A357fb2fb29C14734e
NEXT_PUBLIC_MUSDQ_ADDRESS=0x003fafB5126a5296c6edC7C23De55daf2E84B503

# Relayer API base URL(s), comma-separated for failover (first reachable wins).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Relayer admin key for the server-side admin proxy (merchant onboarding / demo list).
# Server-only: consumed by app/api/admin/[...path]/route.ts — NEVER prefix with NEXT_PUBLIC_,
# or it ships to the browser bundle. Must match ADMIN_API_KEY in backend/.env.
ADMIN_API_KEY=