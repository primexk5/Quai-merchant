# Copy to `.env` and fill in. NEVER commit a real private key.
#
# cp .env.example .env

# --- Network ---
# Orchard testnet (default):
RPC_URL=https://orchard.rpc.quai.network
CHAIN_ID=15000
# Mainnet:
# RPC_URL=https://rpc.quai.network
# CHAIN_ID=9

# --- Deployer key ---
# Quai account private key. The corresponding address must start with 0x00 (Cyprus-1 zone)
# and hold testnet QUAI for gas. Fund it from the Quai faucet.
CYPRUS1_PK=

# --- PayWithQuai initializer config ---
# Where platform fees are sent (defaults to the deployer if unset). Must be in the same Quai
# zone as the deployment (Cyprus-1, 0x00...) and must accept native value without reverting.
FEE_RECIPIENT=
# Platform fee in basis points (0 = no fee, 50 = 0.5%, max 500 = 5%).
FEE_BPS=0
# Optional: a real stablecoin address to allowlist at deploy time (mainnet). On testnet the
# deployed MockStablecoin is allowlisted automatically.
STABLECOIN_ADDR=

# --- Upgrade governance (UUPS) ---
# If set, the deploy script deploys a TimelockController (proposer/executor = this multisig) and
# transfers proxy ownership to it, so upgrades require multisig approval + a time delay. Leave
# unset on testnet to keep the deployer EOA as owner for fast iteration. Use a Gnosis Safe here.
MULTISIG_ADDR=
# Timelock delay in seconds before a scheduled upgrade can execute (default 172800 = 48h).
TIMELOCK_MIN_DELAY=172800

# --- payDemo.js only ---
# Merchant payout wallet used by the end-to-end demo (defaults to the deployer if unset).
MERCHANT_ADDR=
